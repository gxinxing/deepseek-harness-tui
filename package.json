{
  "name": "deepseek-harness-tui",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive terminal chat TUI for the DeepSeek Harness (dsh)",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.js",
    "test:coverage": "node --experimental-vm-modules --test --experimental-test-coverage test/*.js",
    "lint": "eslint src test --ext .js",
    "lint:fix": "eslint src test --ext .js --fix",
    "lint:yaml": "node scripts/lint-yaml.cjs .github/workflows/*.yml",
    "format": "prettier --write 'src/**/*.js' 'test/**/*.js' '**/*.yml'",
    "format:check": "prettier --check 'src/**/*.js' 'test/**/*.js' '**/*.yml'",
    "typecheck": "echo 'no typecheck configured for JS-only project'",
    "check": "pnpm lint && pnpm lint:yaml && pnpm knip && pnpm format:check && pnpm test",
    "check:ci": "pnpm lint && pnpm lint:yaml && pnpm knip --reporter summary && pnpm format:check && pnpm test",
    "knip": "knip --dependencies",
    "deps:check": "npm-check-updates --format group && npm-check-updates --audit",
    "deps:update": "npm-check-updates -u && pnpm install",
    "deps:audit": "pnpm audit --audit-level=moderate",
    "prepare": "husky install",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "husky": "^9.1.0",
    "knip": "^6.32.2",
    "lint-staged": "^15.0.0",
    "npm-check-updates": "^17.0.0",
    "prettier": "^3.3.0",
    "actionlint": "^2.0.6"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "knip": {
    "ignore": ["**/*.test.js"],
    "ignoreDependencies": ["@deepseek-ai/*", "ink-spinner"]
  },
  "volta": {
    "node": ">=20 <23",
    "pnpm": ">=9"
  }
}
